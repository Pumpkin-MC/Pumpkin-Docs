{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "id": {
            "type": "integer"
        },
        "name": {
            "type": "string"
        },
        "details": {
            "type": "object",
            "properties": {
                "short_description": {
                    "type": "string"
                },
                "long_description": {
                    "type": "string"
                },
                "direction": {
                    "type": "string",
                    "enum": ["server-bound", "client-bound"]
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field"
                    }
                },
                "types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/local-type"
                    }
                }
            },
            "required": [
                "short_description",
                "long_description",
                "direction",
                "fields"
            ],
            "additionalProperties": false
        }
    },
    "required": ["name", "id"],
    "additionalProperties": false,
    "$defs": {
        "field-type-primitive": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "primitive"
                },
                "name": {
                    "type": "string",
                    "enum": [
                        "i8",
                        "i16",
                        "i32",
                        "i64",
                        "u8",
                        "u16",
                        "u32",
                        "u64",
                        "vi32",
                        "vi64",
                        "vu32",
                        "vu64",
                        "f32",
                        "f64",
                        "bool",
                        "string"
                    ]
                }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
        },
        "field-type-reference": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": ["local", "global"]
                },
                "name": {
                    "type": "string"
                }
            },
            "required": ["kind", "name"],
            "additionalProperties": false
        },
        "field-type-array": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "array"
                },
                "item": {
                    "$ref": "#/$defs/field-type"
                },
                "length": {
                    "type": "string",
                    "enum": ["u8", "u16", "u32", "u64", "vu32", "vu64"]
                }
            },
            "required": ["kind", "item", "length"],
            "additionalProperties": false
        },
        "field-type-optional": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "optional"
                },
                "payload": {
                    "$ref": "#/$defs/field-type"
                }
            },
            "required": ["kind", "payload"],
            "additionalProperties": false
        },
        "field-type-nbt": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "nbt"
                }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "field-type-blob": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "blob"
                },
                "schema": {
                    "$ref": "#/$defs/field-type"
                }
            },
            "required": ["kind"],
            "additionalProperties": false
        },
        "field-type": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "primitive",
                        "local",
                        "global",
                        "array",
                        "optional",
                        "nbt",
                        "blob"
                    ]
                }
            },
            "oneOf": [
                { "$ref": "#/$defs/field-type-primitive" },
                { "$ref": "#/$defs/field-type-reference" },
                { "$ref": "#/$defs/field-type-array" },
                { "$ref": "#/$defs/field-type-optional" },
                { "$ref": "#/$defs/field-type-nbt" },
                { "$ref": "#/$defs/field-type-blob" }
            ]
        },
        "field": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/$defs/field-type"
                },
                "description": {
                    "type": "string"
                },
                "optional": {
                    "type": "boolean"
                }
            },
            "required": ["name", "type", "description"],
            "additionalProperties": false
        },

        "local-type-enum": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "const": "enum"
                },
                "repr": {
                    "type": "string",
                    "enum": ["u8", "u16", "u32", "u64"]
                },
                "members": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "value": {
                                "type": "integer"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "required": ["name", "value", "description"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["name", "kind", "description", "repr"],
            "additionalProperties": false
        },
        "local-type-record": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "const": "record"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field"
                    }
                }
            },
            "required": ["name", "kind", "description", "fields"],
            "additionalProperties": false
        },
        "local-type": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "enum": ["enum", "record"]
                }
            },
            "oneOf": [
                { "$ref": "#/$defs/local-type-enum" },
                { "$ref": "#/$defs/local-type-record" }
            ]
        }
    }
}
